{
  "name": "foss-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres",
    "db:logs": "docker-compose logs postgres",
    "postinstall": "prisma generate",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@payloadcms/db-mongodb": "^3.35.0",
    "@payloadcms/db-postgres": "^3.43.0",
    "@payloadcms/next": "^3.35.0",
    "@payloadcms/richtext-lexical": "^3.56.0",
    "@supabase/supabase-js": "^2.50.0",
    "framer-motion": "^12.0.11",
    "graphql": "^16.10.0",
    "lucide-react": "^0.503.0",
    "mongoose": "^8.10.0",
    "next": "^15.4.1",
    "payload": "^3.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.16.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.19.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "esbuild": "^0.24.2"
  }
}
